# Copied to .env by setup.sh. run.sh loads it. Everything here is optional.
# Secrets live ONLY here (never in the database); the dashboard shows "set / not set", never the values.
# STUDIO_PORT=8787
# STUDIO_HOME=$HOME/AIGameStudio        # where data/ (SQLite, worktrees), games/ and feedback/ live; default = this folder
# Seed values for Settings on first start (afterwards change them in the dashboard):
# STUDIO_ENGINE=agy                     # agy | gemini_cli | genai | ollama | fake
# STUDIO_AGY_MODEL=                     # pick a slug from `agy models`; empty = your agy default
# STUDIO_GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot
# Fallback engine (Gemini API key from https://aistudio.google.com/apikey) - pay-as-you-go/free tier, separate from AI Pro:
# GEMINI_API_KEY=
# Android export (see README step 5):
# ANDROID_HOME=$HOME/Library/Android/sdk
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
# Release signing is yours (never committed, never created by the studio):
# GODOT_ANDROID_KEYSTORE_RELEASE_PATH=
# GODOT_ANDROID_KEYSTORE_RELEASE_USER=
# GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=

# Customer Support: optional support mailbox, read-only (messages are not marked read, nothing is ever sent).
# Turn it on in Settings > Feedback sources > feedback_imap_enabled. For Gmail use an app password.
# STUDIO_IMAP_HOST=imap.example.com
# STUDIO_IMAP_PORT=993
# STUDIO_IMAP_SSL=1
# STUDIO_IMAP_USER=support@example.com
# STUDIO_IMAP_PASSWORD=

# Optional owner notifications to your own private channel (e.g. an ntfy.sh topic URL). Off until
# Settings > Notifications > notify_webhook is on. Never used to contact players.
# STUDIO_NOTIFY_WEBHOOK=
