[remap]

importer="font_data_dynamic"
type="FontFile"

[params]

antialiasing=1
generate_mipmaps=false
disable_embedded_bitmaps=true
multichannel_signed_distance_field=true
msdf_pixel_range=40
msdf_size=96
allow_system_fallback=true
force_autohinter=false
hinting=1
subpixel_positioning=1
oversampling=0.0
Fallbacks=null
fallbacks=[]
compress=true
preload=[]
language_support={}
script_support={}
opentype_features={}
